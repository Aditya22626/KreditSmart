generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

enum LenderType {
  BANK
  NBFC
  OTHER
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
  STALE
}

enum RateType {
  FIXED
  FLOATING
  MIXED
  UNKNOWN
}

enum FeeType {
  PROCESSING
  PREPAYMENT
  LATE_PAYMENT
  OTHER
}

enum EmploymentType {
  SALARIED
  SELF_EMPLOYED
  STUDENT
  UNEMPLOYED
  OTHER
}

enum DocumentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum MessageRole {
  USER
  ASSISTANT
}

model User {
  id              String            @id @default(uuid()) @db.Uuid
  email           String            @unique @db.VarChar(254)
  displayName     String?           @db.VarChar(120)
  passwordHash    String?
  emailVerifiedAt DateTime?
  role            UserRole          @default(USER)
  status          AccountStatus     @default(ACTIVE)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  identities      AuthIdentity[]
  sessions        AuthSession[]
  profile         FinancialProfile?
  liabilities     Liability[]
  savedLoans      SavedLoan[]
  comparisons     Comparison[]
  documents       Document[]
  conversations   AiConversation[]
  auditEvents     AuditEvent[]
}

model AuthIdentity {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  provider        String   @db.VarChar(40)
  providerSubject String   @db.VarChar(255)
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
}

model AuthSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model FinancialProfile {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @unique @db.Uuid
  monthlyIncome   Decimal?        @db.Decimal(15, 2)
  monthlyExpenses Decimal?        @db.Decimal(15, 2)
  employmentType  EmploymentType?
  selfReportedAge Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Liability {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @db.Uuid
  label                String   @db.VarChar(120)
  outstandingPrincipal Decimal  @db.Decimal(15, 2)
  monthlyPayment       Decimal  @db.Decimal(15, 2)
  annualRate           Decimal? @db.Decimal(7, 4)
  remainingMonths      Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LoanCategory {
  id          String        @id @default(uuid()) @db.Uuid
  slug        String        @unique @db.VarChar(80)
  name        String        @db.VarChar(120)
  description String
  products    LoanProduct[]
}

model Lender {
  id         String        @id @default(uuid()) @db.Uuid
  slug       String        @unique @db.VarChar(100)
  name       String        @db.VarChar(160)
  type       LenderType
  websiteUrl String?
  isDemo     Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  products   LoanProduct[]
}

model LoanProduct {
  id              String           @id @default(uuid()) @db.Uuid
  lenderId        String           @db.Uuid
  categoryId      String           @db.Uuid
  slug            String           @unique @db.VarChar(120)
  name            String           @db.VarChar(160)
  description     String
  status          ProductStatus    @default(DRAFT)
  currency        String           @default("INR") @db.Char(3)
  minAmount       Decimal?         @db.Decimal(15, 2)
  maxAmount       Decimal?         @db.Decimal(15, 2)
  minTenureMonths Int?
  maxTenureMonths Int?
  rateType        RateType         @default(UNKNOWN)
  isDemo          Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  lender          Lender           @relation(fields: [lenderId], references: [id], onDelete: Restrict)
  category        LoanCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  rateSnapshots   RateSnapshot[]
  fees            LoanFee[]
  eligibility     EligibilityRule?
  sources         ProductSource[]
  savedBy         SavedLoan[]
  comparisonItems ComparisonItem[]

  @@index([categoryId, status, isDemo])
  @@index([lenderId, status])
}

model ProductSource {
  id         String             @id @default(uuid()) @db.Uuid
  productId  String             @db.Uuid
  url        String
  title      String?            @db.VarChar(200)
  status     VerificationStatus @default(UNVERIFIED)
  observedAt DateTime           @default(now())
  verifiedAt DateTime?
  product    LoanProduct        @relation(fields: [productId], references: [id], onDelete: Cascade)
  snapshots  RateSnapshot[]

  @@unique([productId, url])
  @@unique([id, productId])
}

model RateSnapshot {
  id            String         @id @default(uuid()) @db.Uuid
  productId     String         @db.Uuid
  sourceId      String?        @db.Uuid
  minAnnualRate Decimal        @db.Decimal(7, 4)
  maxAnnualRate Decimal        @db.Decimal(7, 4)
  effectiveAt   DateTime
  observedAt    DateTime       @default(now())
  product       LoanProduct    @relation(fields: [productId], references: [id], onDelete: Cascade)
  source        ProductSource? @relation(fields: [sourceId, productId], references: [id, productId], onDelete: NoAction)

  @@unique([productId, effectiveAt])
  @@index([productId, observedAt])
}

model LoanFee {
  id          String      @id @default(uuid()) @db.Uuid
  productId   String      @db.Uuid
  type        FeeType
  label       String      @db.VarChar(160)
  fixedAmount Decimal?    @db.Decimal(15, 2)
  percentage  Decimal?    @db.Decimal(7, 4)
  notes       String?
  product     LoanProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, type, label])
}

model EligibilityRule {
  id               String           @id @default(uuid()) @db.Uuid
  productId        String           @unique @db.Uuid
  minAge           Int?
  maxAge           Int?
  minMonthlyIncome Decimal?         @db.Decimal(15, 2)
  employmentTypes  EmploymentType[]
  notes            String?
  updatedAt        DateTime         @updatedAt
  product          LoanProduct      @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model SavedLoan {
  userId    String      @db.Uuid
  productId String      @db.Uuid
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   LoanProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([productId])
}

model Comparison {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @db.Uuid
  name         String           @db.VarChar(120)
  amount       Decimal?         @db.Decimal(15, 2)
  tenureMonths Int?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        ComparisonItem[]

  @@index([userId, createdAt])
}

model ComparisonItem {
  comparisonId String      @db.Uuid
  productId    String      @db.Uuid
  comparison   Comparison  @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  product      LoanProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([comparisonId, productId])
  @@index([productId])
}

model Document {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @db.Uuid
  storageKey   String         @unique
  originalName String         @db.VarChar(255)
  mimeType     String         @db.VarChar(120)
  byteSize     Int
  status       DocumentStatus @default(PENDING)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AiConversation {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  title     String?     @db.VarChar(160)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AiMessage[]

  @@index([userId, updatedAt])
}

model AiMessage {
  id             String         @id @default(uuid()) @db.Uuid
  conversationId String         @db.Uuid
  role           MessageRole
  content        String
  createdAt      DateTime       @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(100)
  entityId   String?  @db.VarChar(120)
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
}
